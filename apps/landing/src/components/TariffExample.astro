---
// Illustrated Cek tarif list (data rekaan, T-296/T-297). The chosen quote is the sample
// label's courier and the COD sample's shipping, so the flow, the label and the COD table
// tell one shipment.
import { SAMPLE_LABEL as label, formatIdr } from "../lib/sample.mjs";

const quotes = [
  { logo: "/logos/kurir/jnt.svg", service: "EZ", eta: "2–3 hari", price: label.cod.shippingIdr, chosen: true },
  { logo: "/logos/kurir/sicepat.svg", service: "REG", eta: "2–3 hari", price: 15_500, chosen: false },
  { logo: "/logos/kurir/jne.svg", service: "REG", eta: "2–3 hari", price: 16_000, chosen: false },
  { logo: "/logos/kurir/idx.svg", service: "STD", eta: "3–4 hari", price: 15_000, chosen: false },
];
---
<figure class="grid gap-3">
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" aria-hidden="true">
    <p class="text-sm font-semibold text-slate-500">Cek tarif · 1 kg · Kota Bandung</p>
    <ul class="mt-3 divide-y divide-slate-100">
      {quotes.map((quote) => (
        <li class:list={["flex items-center justify-between gap-3 px-2 py-3", quote.chosen && "rounded-lg bg-brand-blue-pale outline outline-2 outline-brand-blue"]}>
          <span class="flex items-center gap-3">
            <img src={quote.logo} alt="" width="64" height="24" class="h-6 w-16 object-contain" loading="lazy" />
            <span class="whitespace-nowrap text-sm text-slate-600">{quote.service} · {quote.eta}</span>
          </span>
          <span class="text-base font-bold tabular-nums text-slate-900">{formatIdr(quote.price)}</span>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-sm font-semibold text-brand-navy">Dipilih: {label.courier} {formatIdr(label.cod.shippingIdr)} → resi {label.awb}</p>
  </div>
  <figcaption class="text-sm text-slate-500">Contoh tampilan cek tarif dengan data rekaan; tarif nyata datang dari Mengantar saat Anda mengecek.</figcaption>
</figure>
