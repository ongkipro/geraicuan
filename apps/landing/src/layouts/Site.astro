---
// Shared frame for the GeraiCuan landing pages (T-296). Static; no client JavaScript.
import { Font } from "astro:assets";
import "../styles/site.css";
import { BRAND, NAV, SIGN_IN_URL, SIGN_UP_URL, SITE_ORIGIN, WHATSAPP_DISPLAY } from "../lib/site.mjs";

interface Props {
  title: string;
  description: string;
  path: string;
  /** The 404 page: kept out of search results and without a canonical URL. */
  noindex?: boolean;
}
const { title, description, path, noindex = false } = Astro.props;

// Owner SEO rule (2026-09-30): title 55-70 characters, description 120-155 ending
// with a full stop, never "|" or an em dash. A page outside the range fails the build.
if (title.length < 55 || title.length > 70 || /[|—]/.test(title)) {
  throw new Error(`${path}: title must be 55-70 characters without "|" or "—" (${title.length}): ${title}`);
}
if (description.length < 120 || description.length > 155 || !description.endsWith(".") || /[|—]/.test(description)) {
  throw new Error(`${path}: description must be 120-155 characters ending with "." (${description.length})`);
}

const canonical = new URL(path, SITE_ORIGIN).href;
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: BRAND,
  url: `${SITE_ORIGIN}/`,
  logo: `${SITE_ORIGIN}/apple-touch-icon.png`,
};
const isCurrent = (href: string) => href === path;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={BRAND} />
    <meta name="publisher" content={BRAND} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#071E3D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body class="font-sans antialiased">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-brand-navy" href="#utama">Lompat ke konten utama</a>

    <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:h-[4.5rem] sm:px-6 lg:px-8">
        <a href="/" class="flex shrink-0 items-center py-1" aria-label={`${BRAND}, beranda`}>
          <img src="/logos/logo-geraicuan-mengantar-dark.svg" alt="" width="320" height="80" class="h-9 w-auto sm:h-11" />
        </a>
        <nav class="hidden md:block" aria-label="Navigasi utama">
          <ul class="flex items-center gap-6 text-sm font-semibold text-slate-600 lg:gap-8">
            {NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                  class:list={["py-2 transition-colors hover:text-brand-blue", isCurrent(item.href) && "text-brand-navy underline decoration-brand-blue decoration-2 underline-offset-8"]}
                >{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="flex items-center gap-2">
          <a href={SIGN_IN_URL} data-cta="masuk" class="inline-flex min-h-11 items-center px-2 text-sm font-semibold text-slate-700 hover:text-brand-blue sm:px-3">Masuk</a>
          <a href={SIGN_UP_URL} data-cta="daftar" class="hidden min-h-11 items-center whitespace-nowrap rounded-full bg-brand-blue px-5 text-sm font-bold text-white transition-colors hover:bg-brand-blue-hover sm:inline-flex">Daftar gratis</a>
          <details class="group relative md:hidden">
            <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-lg border border-slate-300 px-3 text-sm font-semibold text-slate-700 [&::-webkit-details-marker]:hidden">
              Menu
            </summary>
            <nav class="absolute right-0 mt-2 w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-xl" aria-label="Navigasi seluler">
              <ul class="flex flex-col text-base font-medium text-slate-700">
                {NAV.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined} class:list={["flex min-h-11 items-center rounded-lg px-3 hover:bg-slate-50", isCurrent(item.href) && "bg-slate-50 font-bold text-brand-navy"]}>{item.label}</a>
                  </li>
                ))}
                <li class="mt-1 border-t border-slate-100 pt-1">
                  <a href={SIGN_UP_URL} data-cta="daftar" class="flex min-h-11 items-center rounded-lg px-3 font-bold text-brand-blue hover:bg-brand-blue-pale">Daftar gratis</a>
                </li>
                <li>
                  <a href={SIGN_IN_URL} data-cta="masuk" class="flex min-h-11 items-center rounded-lg px-3 font-semibold text-slate-700 hover:bg-slate-50">Masuk ke aplikasi</a>
                </li>
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="utama">
      <slot />
    </main>

    <footer class="bg-slate-50 py-12 text-sm text-slate-600">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 md:grid-cols-[1.4fr_1fr] lg:px-8">
        <div class="max-w-md space-y-3">
          <img src="/logos/logo-geraicuan-mengantar-dark.svg" alt={`${BRAND} powered by Mengantar`} width="320" height="80" class="h-10 w-auto" loading="lazy" />
          <p>Aplikasi kasir loket pengiriman multi-kurir untuk toko, konter, dan agen ritel di Indonesia. Gratis, tanpa biaya franchise.</p>
          <p>Dikembangkan bersama tim <a href="https://mengantar.com/" class="font-semibold text-slate-800 underline-offset-4 hover:underline" rel="noopener">Mengantar</a>.</p>
          <p>WhatsApp onboarding: {WHATSAPP_DISPLAY}</p>
        </div>
        <div class="grid grid-cols-2 gap-x-6">
          <nav aria-labelledby="footer-halaman">
            <p id="footer-halaman" class="text-xs font-bold text-slate-900">Halaman</p>
            <ul class="mt-1">
              {NAV.map((item) => (
                <li><a href={item.href} class="inline-flex min-h-11 items-center hover:text-brand-blue">{item.label}</a></li>
              ))}
            </ul>
          </nav>
          <nav aria-labelledby="footer-akun">
            <p id="footer-akun" class="text-xs font-bold text-slate-900">Akun gerai</p>
            <ul class="mt-1">
              <li><a href={SIGN_UP_URL} data-cta="daftar" class="inline-flex min-h-11 items-center hover:text-brand-blue">Daftar gratis</a></li>
              <li><a href={SIGN_IN_URL} data-cta="masuk" class="inline-flex min-h-11 items-center hover:text-brand-blue">Masuk</a></li>
            </ul>
          </nav>
        </div>
        <p class="border-t border-slate-200 pt-6 text-xs text-slate-500 md:col-span-2">© 2026 {BRAND} · Bahasa Indonesia · Rupiah · WIB</p>
      </div>
    </footer>
  </body>
</html>
