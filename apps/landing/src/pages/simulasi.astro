---
// Commission estimate, Mengantar discount tiers and FAQ (T-296, T-297). The commission is the
// owner's term; the tiers, COD fee, return and payout rules are Mengantar's published terms.
import Site from "../layouts/Site.astro";
import PageHero from "../components/PageHero.astro";
import ClosingCta from "../components/ClosingCta.astro";
import ProfitSimulator from "../components/ProfitSimulator.astro";
import { MENGANTAR_DISCOUNT_TIERS, MENGANTAR_URL } from "../lib/site.mjs";

const title = "Simulasi Komisi dan Keuntungan Loket Ekspedisi Toko - GeraiCuan";
const description = "Hitung estimasi keuntungan loket ekspedisi di toko Anda dengan simulator komisi GeraiCuan. Komisi 20%-25% per paket, tanpa franchise atau royalti.";

const comparison = [
  ["Biaya kemitraan awal", "Gratis", "Ada biaya kemitraan"],
  ["Keuntungan diskon ongkir", "Komisi 20%–25% jadi laba", "Komisi lebih kecil, sering ada target"],
  ["Pilihan ekspedisi", "Banyak kurir resmi di 1 layar", "Cuma 1 kurir"],
  ["Royalti bulanan", "Tidak ada, 100% milik toko", "Dipotong royalti atau lisensi"],
  ["Syarat tempat", "Meja kasir yang sudah ada", "Wajib sewa ruko dan cat khusus"],
  ["Target minimum paket", "Tanpa target, tanpa penalti", "Wajib capai target"],
  ["Penjemputan paket", "Kurir resmi jemput ke toko", "Sebagian wajib antar ke hub"],
];

const faq = [
  ["Dari mana asal keuntungan toko saya?", "Dari diskon ongkir Mengantar. Setiap kiriman otomatis mendapat diskon 20%, dan diskonnya naik sesuai jumlah kiriman per bulan (lihat tabel di atas). Pelanggan membayar tarif normal kurir, dan selisih diskonnya menjadi laba toko tanpa potongan royalti."],
  ["Siapa di balik GeraiCuan?", "GeraiCuan dikembangkan bersama tim Mengantar, agregator pengiriman yang menghubungkan gerai Anda ke ekspedisi resmi. Kiriman, resi, dan pencairan COD berjalan lewat akun Mengantar milik gerai Anda."],
  ["Bagaimana dana COD sampai ke rekening toko?", "Mengantar mencairkan dana COD setiap hari, termasuk akhir pekan dan hari libur: kiriman yang terkirim sebelum 19.45 WIB dicairkan pukul 20.00 WIB hari itu, ke akun Mengantar gerai Anda. Di GeraiCuan, pemilik gerai memantau estimasi dana cair di menu Pencairan COD."],
  ["Bagaimana kalau paket COD retur?", "Ongkir pulang paket retur digratiskan Mengantar. Gerai hanya membayar ongkir pergi, yang sudah dipotong diskon."],
  ["Apakah benar tidak ada biaya tersembunyi?", "Benar. GeraiCuan tidak memungut biaya pendaftaran, iuran bulanan, maupun lisensi. Tarif kurir dan fee COD (3% ditambah PPN) tampil sebelum resi terbit. Mengantar mengasuransikan paket di bawah Rp 500 ribu secara gratis; di atasnya biayanya Rp 1 ribu per paket."],
  ["Apakah gerai langsung aktif setelah daftar?", "Daftar dengan email dan nomor WhatsApp gerai, lalu verifikasi email. Setelah masuk, lengkapi profil dan hubungkan akun Mengantar gerai di Pengaturan. Gerai mulai mengirim setelah pendaftaran disetujui admin GeraiCuan."],
];
---
<Site title={title} description={description} path="/simulasi/">
  <PageHero
    title="Hitung potensi tambahan keuntungan toko Anda"
    lead="Geser target kiriman per hari. Estimasi komisi bulanan dan tahunan langsung dihitung."
    showSignUp={false}
  />

  <section class="bg-slate-50 pb-14 sm:pb-20" aria-label="Simulator komisi">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <ProfitSimulator id="sim-simulasi" />
    </div>
  </section>

  <section id="diskon" class="py-14 sm:py-20" aria-labelledby="judul-diskon">
    <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_1fr]">
      <div>
        <h2 id="judul-diskon" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Diskon ongkir naik mengikuti volume</h2>
        <p class="mt-3 text-base leading-relaxed text-slate-600">
          Komisi toko berasal dari diskon ongkir Mengantar. Setiap kiriman otomatis mendapat diskon 20%, dan diskonnya naik sesuai jumlah kiriman per bulan.
          Diskon berlaku untuk kiriman COD maupun Non-COD. Komisi 20%–25% yang kami sebut adalah rentang untuk gerai dengan sampai 7.500 kiriman sebulan.
        </p>
        <p class="mt-4 text-sm text-slate-500">Sumber: ketentuan diskon di <a href={MENGANTAR_URL} class="font-semibold text-brand-blue underline-offset-4 hover:underline" rel="noopener">mengantar.com</a>, dibaca 10 Oktober 2026. Ketentuan bisa berubah mengikuti Mengantar.</p>
      </div>
      <table class="w-full border-collapse overflow-hidden rounded-2xl bg-white text-left text-base tabular-nums ring-1 ring-slate-200">
        <caption class="sr-only">Diskon ongkir Mengantar per jumlah kiriman sebulan</caption>
        <thead>
          <tr class="border-b border-slate-200 text-sm text-slate-600">
            <th scope="col" class="p-4 font-semibold">Kiriman per bulan</th>
            <th scope="col" class="p-4 text-right font-semibold">Diskon ongkir</th>
          </tr>
        </thead>
        <tbody>
          {MENGANTAR_DISCOUNT_TIERS.map((tier) => (
            <tr class="border-b border-slate-100 last:border-0">
              <th scope="row" class="p-4 font-medium text-slate-800">{tier.volume}</th>
              <td class="p-4 text-right font-bold text-brand-navy">{tier.discount}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20" aria-labelledby="judul-banding">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 id="judul-banding" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">GeraiCuan dibanding franchise biasa</h2>
      <p class="mt-2 text-base leading-relaxed text-slate-600">Syarat dan keuntungan membuka loket di toko Anda.</p>
      <ul class="mt-8 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white md:hidden">
        {comparison.map(([criterion, ours, franchise]) => (
          <li class="p-4">
            <p class="text-sm font-semibold text-slate-500">{criterion}</p>
            <p class="mt-1 rounded-lg bg-brand-blue-pale px-2 py-1 text-base font-bold text-brand-navy">GeraiCuan: {ours}</p>
            <p class="mt-1 text-sm text-slate-600">Franchise: {franchise}</p>
          </li>
        ))}
      </ul>
      <div class="mt-8 hidden overflow-x-auto rounded-2xl border border-slate-200 bg-white md:block">
        <table class="w-full border-collapse text-left text-sm sm:text-base">
          <thead>
            <tr class="border-b border-slate-200 text-slate-700">
              <th scope="col" class="p-4 font-semibold">Kriteria</th>
              <th scope="col" class="bg-brand-blue-pale p-4 font-bold text-brand-navy">Loket GeraiCuan</th>
              <th scope="col" class="p-4 font-semibold">Franchise kurir konvensional</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(([criterion, ours, franchise]) => (
              <tr class="border-b border-slate-100 last:border-0">
                <th scope="row" class="p-4 font-semibold text-slate-900">{criterion}</th>
                <td class="bg-brand-blue-pale/60 p-4 font-semibold text-brand-navy">{ours}</td>
                <td class="p-4 text-slate-500">{franchise}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="faq" class="py-14 sm:py-20" aria-labelledby="judul-faq">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 id="judul-faq" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Pertanyaan seputar komisi loket</h2>
      <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
        {faq.map(([question, answer], index) => (
          <details class="group py-2" open={index === 0}>
            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-bold text-slate-900 [&::-webkit-details-marker]:hidden">
              {question}
              <svg aria-hidden="true" class="size-5 shrink-0 text-slate-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <p class="pb-4 pr-9 text-base leading-relaxed text-slate-600">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta heading="Mulai kumpulkan komisi dari toko Anda" />
</Site>
