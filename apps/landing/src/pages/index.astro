---
// GeraiCuan home (PR-63, T-296): the loket positioning from the owner's redesign
// (origin/landing-page a2f7a7e), with product facts checked against the CMS.
import Site from "../layouts/Site.astro";
import ClosingCta from "../components/ClosingCta.astro";
import ProfitSimulator from "../components/ProfitSimulator.astro";
import TariffExample from "../components/TariffExample.astro";
import { ORDERABLE_COURIERS, QUOTE_ONLY_COURIERS, SIGN_UP_URL } from "../lib/site.mjs";
import { SAMPLE_LABEL as label, encodeCode128B, formatIdr } from "../lib/sample.mjs";

const title = "Buka Loket 12+ Layanan Ekspedisi Resmi di Toko Anda - GeraiCuan";
const description = "Buka loket ekspedisi resmi di toko Anda, gratis tanpa franchise. Komisi 20%-25% per paket, cek ongkir banyak kurir, cetak resi, kurir jemput ke toko.";

const bars = encodeCode128B(label.awb);
const cod = label.cod;

const businesses = [
  { image: "mitra-brilink-gerai", alt: "Ilustrasi konter pulsa dan PPOB yang juga melayani titip kirim paket", title: "Konter pulsa & PPOB", text: "Terima kiriman paket dengan komisi bersih Rp 3.000–Rp 15.000 per paket. Kirim 40 paket sehari, tambahan laba sekitar Rp 4 juta per bulan." },
  { image: "mitra-fotocopy-atk", alt: "Ilustrasi toko fotokopi dan ATK yang menerima kiriman paket pelanggan", title: "Toko fotokopi & ATK", text: "Warga, pelajar, dan olshop sekitar bisa langsung titip kirim paket. Pengunjung bertambah, omzet fotokopi ikut naik." },
  { image: "mitra-sembako-ruko", alt: "Ilustrasi toko sembako dengan meja kasir untuk loket kirim paket", title: "Toko sembako & kelontong", text: "Pakai sudut meja kasir yang sudah ada. Pembeli sembako sekalian kirim paket, kasir jadi lebih produktif." },
  { image: "mitra-kelontong-mart", alt: "Ilustrasi minimarket lokal sebagai titik drop paket warga sekitar", title: "Minimarket & swalayan lokal", text: "Layanan toko makin lengkap. Jadi titik drop paket warga sekitar dengan komisi harian." },
  { image: "mitra-gerai-ekspedisi", alt: "Ilustrasi gerai ekspedisi multi-kurir dengan tumpukan paket siap kirim", title: "Agen pengiriman baru", text: "Buka loket multi-kurir resmi tanpa modal franchise puluhan juta. Semua pilihan ekspedisi ada di satu sistem." },
  { image: "mitra-frozen-food", alt: "Ilustrasi toko makanan yang melayani kiriman hampers dan oleh-oleh", title: "Toko makanan & oleh-oleh", text: "Layani kiriman hampers, kue kering, dan oleh-oleh pelanggan langsung dari toko Anda." },
];

const problems = [
  ["Franchise mahal & cuma 1 kurir", "Ada biaya kemitraan jutaan rupiah, tapi hanya dapat 1 ekspedisi. Pelanggan pindah ke toko lain kalau kurir yang dicari tidak ada."],
  ["Uang kasir rawan bocor", "Catatan manual sulit dipantau. Transaksi bisa dibatalkan diam-diam tanpa diketahui pemilik toko."],
  ["Tekor denda salah timbang", "Salah ukur kardus, selisih ongkir dipotong dari kantong toko. Hasil kerja seharian habis untuk denda."],
];

const comparison = [
  ["Modal awal kemitraan", "Ada biaya kemitraan", "Gratis, tapi tanpa sistem kasir", "Gratis, tanpa biaya kemitraan"],
  ["Keuntungan per paket", "Komisi lebih kecil, sering ada target", "Tarif normal kurir, tanpa margin", "Komisi 20%–25% jadi laba toko"],
  ["Pilihan ekspedisi", "Cuma 1 kurir", "Buka banyak tab, kasir pusing", "Banyak kurir resmi di 1 layar"],
  ["Kewajiban beli alat", "Wajib beli paket alat", "Alat seadanya tanpa printer resi", "Pakai HP, laptop & printer toko"],
  ["Bagi hasil / royalti", "Dipotong royalti bulanan", "Tidak ada bagi hasil", "100% milik toko, bebas royalti"],
  ["Penjemputan paket", "Sering antar sendiri ke hub", "Telepon agen kurir manual", "Jadwalkan jemput kurir dari aplikasi"],
  ["Selisih berat & ukuran", "Sering nombok denda selisih", "Rawan salah timbang", "Ongkir dihitung dari berat dan ukuran sebelum resi terbit"],
  ["Keamanan uang kasir", "Rawan kecurangan kasir", "Rawan selisih saat tutup toko", "Peran kasir dibatasi, pemilik pantau dari HP"],
];

const advantages = [
  ["Gratis tanpa biaya franchise", "Tanpa biaya pendaftaran dan tanpa iuran bulanan. Cukup pakai laptop, HP, dan printer yang sudah ada di toko."],
  ["Komisi bersih 20%–25%", "Pelanggan bayar tarif resmi kurir, komisi 20%–25% jadi laba toko tanpa potongan royalti."],
  ["Kurir resmi jemput ke toko", "Jadwalkan penjemputan dari aplikasi, kurir resmi datang mengambil paket di toko Anda."],
  ["Drop point multi-ekspedisi", "Warga dan seller online sekitar bisa titip kirim lewat banyak ekspedisi di toko Anda."],
  ["Cek ongkir banyak kurir sekaligus", "Bandingkan tarif ekspedisi di satu layar. Pelanggan langsung pilih yang termurah atau tercepat."],
  ["Anti-nombok selisih berat", "Masukkan berat dan ukuran kardus, ongkir dihitung sebelum resi terbit, jadi toko tidak menanggung selisih."],
  ["COD presisi, cair setiap hari", "Nilai COD dihitung otomatis supaya setelah fee COD Mengantar harga barang tetap tertutup. Mengantar mencairkan dana COD setiap hari; kalau paket retur, ongkir pulangnya gratis."],
  ["Cetak resi & kirim via WhatsApp", "Cetak label thermal 10 × 15 cm sekali klik, lalu kirim nomor resi ke WhatsApp penerima dari halaman kiriman."],
  ["Kasir aman, pantau dari HP", "Operator bekerja dari antrean cetak resi. Pemilik gerai memantau kiriman dan uang gerai dari HP."],
];

const steps = [
  ["Ketik data pengirim & penerima", "Kontak pelanggan tersimpan, jadi pelanggan langganan tidak perlu ketik ulang dari awal.", "Contoh: penerima Ibu Contoh, Coblong, Kota Bandung."],
  ["Timbang & cek ongkir", "Masukkan berat dan ukuran, lalu pilih kurir termurah atau tercepat.", "Contoh: 1 kg, J&T Rp 15.000 dipilih dari daftar tarif."],
  ["Terima pembayaran", "Pelanggan bayar di kasir, tunai atau QRIS milik toko. Komisi jadi laba toko.", "Contoh: pelanggan bayar ongkir tunai di kasir."],
  ["Cetak resi & serahkan", "Resi thermal keluar sekali klik, lalu paket diserahkan ke kurir yang menjemput.", "Contoh: resi JP0000000000001 tercetak 10 × 15 cm."],
];
---
<Site title={title} description={description} path="/">
  <section class="relative isolate overflow-hidden bg-brand-navy-dark text-white" aria-labelledby="judul">
    <img src="/images/mitra-gerai-ekspedisi.webp" alt="" width="1200" height="896" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[72%_center]" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-navy-dark/95 via-brand-navy-dark/85 to-brand-navy-dark/50"></div>
    <div class="mx-auto max-w-7xl px-4 pb-10 pt-16 sm:px-6 sm:pt-24 lg:px-8 lg:pt-28">
      <div class="max-w-3xl">
        <h1 id="judul" class="text-4xl font-black leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">Buka loket 12+ layanan ekspedisi di toko Anda. Gratis.</h1>
        <p class="mt-3 text-xl font-extrabold tracking-tight text-brand-sky sm:text-3xl">Komisi 20%–25% per paket, kurir jemput ke toko</p>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-200 sm:text-lg">
          Konter pulsa, toko kelontong, dan fotokopi bisa langsung terima kiriman J&amp;T, JNE, SiCepat, dan kurir lainnya lewat Mengantar.
          Komisi bersih Rp 3.000–Rp 15.000 per paket, tanpa biaya franchise.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={SIGN_UP_URL} data-cta="daftar" class="inline-flex min-h-12 items-center rounded-full bg-brand-blue px-8 text-base font-bold text-white shadow-lg shadow-brand-blue/30 transition-colors hover:bg-brand-blue-hover">Daftar gratis</a>
          <a href="#simulasi" class="inline-flex min-h-12 items-center rounded-full border border-white/40 px-7 text-base font-semibold text-white transition-colors hover:bg-white/10">Hitung komisi</a>
        </div>
      </div>
      <dl class="mt-14 grid max-w-3xl grid-cols-2 gap-x-8 gap-y-5 border-t border-white/15 pt-6 sm:grid-cols-4">
        <div class="flex flex-col"><dt class="text-sm text-slate-300">Layanan ekspedisi</dt><dd class="order-first text-2xl font-extrabold sm:text-3xl">12+</dd></div>
        <div class="flex flex-col"><dt class="text-sm text-slate-300">Komisi per paket</dt><dd class="order-first text-2xl font-extrabold text-brand-sky sm:text-3xl">20%–25%</dd></div>
        <div class="flex flex-col"><dt class="text-sm text-slate-300">Biaya franchise</dt><dd class="order-first text-2xl font-extrabold sm:text-3xl">Gratis</dd></div>
        <div class="flex flex-col"><dt class="text-sm text-slate-300">Penjemputan</dt><dd class="order-first text-2xl font-extrabold sm:text-3xl">Ke toko</dd></div>
      </dl>
      <p class="mt-4 text-sm text-slate-300">Dikembangkan bersama tim Mengantar · <a href="/simulasi/#diskon" class="underline underline-offset-4 hover:text-white">Dari mana komisi 20%–25% berasal?</a></p>
    </div>
  </section>

  <section class="py-14 sm:py-16" aria-labelledby="judul-kurir">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="judul-kurir" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Ekspedisi resmi lewat Mengantar</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-600">
          GeraiCuan dikembangkan bersama tim Mengantar. Resi resmi dari kurir, bisa dilacak di aplikasi masing-masing. 12+ layanan: delapan kurir di bawah ditambah layanan kargo JNE, SAP, SiCepat, dan ID Express.
        </p>
      </div>
      <p class="mt-10 text-center text-sm font-semibold text-slate-700">Bisa langsung dipesan</p>
      <ul class="mx-auto mt-4 grid max-w-5xl grid-cols-3 items-center justify-items-center gap-x-6 gap-y-8 sm:grid-cols-4 lg:grid-cols-8">
        {ORDERABLE_COURIERS.map((courier) => (
          <li class="flex h-12 items-center"><img src={courier.logo} alt={courier.name} width="110" height="36" class="h-9 w-[110px] object-contain" loading="lazy" /></li>
        ))}
      </ul>
      <p class="mt-8 text-center text-sm text-slate-500">
        Tarif sudah tampil di cek ongkir, pemesanan menyusul:
        {QUOTE_ONLY_COURIERS.map((courier) => <img src={courier.logo} alt={courier.name} width="72" height="24" class="ml-2 inline h-6 w-[72px] object-contain align-middle" loading="lazy" />)}
        <span class="ml-2 font-semibold">SPX</span>
      </p>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20" aria-labelledby="judul-usaha">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center sm:mb-12">
        <h2 id="judul-usaha" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Cocok untuk berbagai jenis usaha</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-600">Pakai meja kasir dan perangkat yang sudah ada di toko. Tanpa sewa tempat baru, tanpa biaya franchise.</p>
      </div>
      <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {businesses.map((item) => (
          <li>
            <img src={`/images/${item.image}.webp`} alt={item.alt} width="1200" height="896" loading="lazy" class="mb-4 aspect-[4/3] w-full rounded-2xl bg-slate-200 object-cover" />
            <h3 class="text-lg font-bold leading-snug text-slate-900">{item.title}</h3>
            <p class="mt-1.5 text-base leading-relaxed text-slate-600">{item.text}</p>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center text-sm text-slate-500">Foto adalah ilustrasi jenis usaha, bukan mitra tertentu.</p>
    </div>
  </section>

  <section class="py-14 sm:py-20" aria-labelledby="judul-masalah">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 id="judul-masalah" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Masalah agen kurir konvensional</h2>
      <p class="mt-2 max-w-2xl text-base leading-relaxed text-slate-600">Franchise kurir biasa umumnya mahal dan penuh syarat yang membebani pemilik toko.</p>
      <ul class="mt-8 grid gap-x-10 gap-y-8 md:grid-cols-3">
        {problems.map(([heading, text]) => (
          <li class="border-l-4 border-red-500 pl-5">
            <h3 class="text-lg font-bold text-slate-900">{heading}</h3>
            <p class="mt-1.5 text-base leading-relaxed text-slate-600">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20" aria-labelledby="judul-banding">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 id="judul-banding" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">GeraiCuan dibanding agen biasa</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-600">Bandingkan membuka loket GeraiCuan dengan franchise kurir konvensional.</p>
      </div>
      <ul class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white md:hidden">
        {comparison.map(([need, franchise, manual, ours]) => (
          <li class="p-4">
            <p class="text-sm font-semibold text-slate-500">{need}</p>
            <p class="mt-1 rounded-lg bg-brand-blue-pale px-2 py-1 text-base font-bold text-brand-navy">GeraiCuan: {ours}</p>
            <p class="mt-1 text-sm text-slate-600">Franchise: {franchise}. Tab manual: {manual}.</p>
          </li>
        ))}
      </ul>
      <div class="hidden overflow-x-auto rounded-2xl border border-slate-200 bg-white md:block">
        <table class="w-full border-collapse text-left text-sm sm:text-base">
          <thead>
            <tr class="border-b border-slate-200 text-slate-700">
              <th scope="col" class="p-4 font-semibold">Kebutuhan loket</th>
              <th scope="col" class="bg-brand-blue-pale p-4 font-bold text-brand-navy">GeraiCuan</th>
              <th scope="col" class="p-4 font-semibold">Franchise konvensional</th>
              <th scope="col" class="p-4 font-semibold">Buka tab web manual</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(([need, franchise, manual, ours]) => (
              <tr class="border-b border-slate-100 last:border-0">
                <th scope="row" class="p-4 font-semibold text-slate-900">{need}</th>
                <td class="bg-brand-blue-pale/60 p-4 font-semibold text-brand-navy">{ours}</td>
                <td class="p-4 text-slate-500">{franchise}</td>
                <td class="p-4 text-slate-500">{manual}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20" aria-labelledby="judul-keunggulan">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_2fr]">
      <div>
        <h2 id="judul-keunggulan" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Keunggulan loket GeraiCuan di toko Anda</h2>
        <p class="mt-3 text-base leading-relaxed text-slate-600">Kemudahan operasional dan keuntungan dalam satu sistem kasir loket.</p>
        <p class="mt-4"><a href="/fitur/" class="font-semibold text-brand-blue underline-offset-4 hover:underline">Lihat semua fitur</a></p>
      </div>
      <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
        {advantages.map(([heading, text]) => (
          <li class="border-t-2 border-brand-blue pt-4">
            <h3 class="text-lg font-bold text-slate-900">{heading}</h3>
            <p class="mt-1.5 text-base leading-relaxed text-slate-600">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="simulasi" class="bg-slate-50 py-14 sm:py-20" aria-labelledby="judul-simulasi">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 id="judul-simulasi" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Hitung tambahan keuntungan toko Anda</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-600">Geser target kiriman untuk melihat estimasi laba dari komisi 20%–25%.</p>
      </div>
      <ProfitSimulator id="sim-beranda" />
    </div>
  </section>

  <section id="alur" class="py-14 sm:py-20" aria-labelledby="judul-alur">
    <div class="mx-auto grid max-w-6xl items-start gap-x-12 gap-y-10 px-4 sm:px-6 lg:grid-cols-[1fr_26rem]">
      <div>
        <h2 id="judul-alur" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Satu kiriman, dari meja kasir sampai resi</h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-slate-600">Melayani kiriman semudah mengisi satu formulir. Ikuti satu contoh paket ke Bandung.</p>
        <ol class="mt-8 space-y-6">
          {steps.map(([heading, text, example], index) => (
            <li class="grid grid-cols-[2rem_1fr] gap-x-4">
              <span class="flex size-8 items-center justify-center rounded-full bg-brand-blue text-sm font-bold text-white" aria-hidden="true">{index + 1}</span>
              <div>
                <h3 class="text-lg font-bold text-slate-900">{heading}</h3>
                <p class="mt-1 text-base leading-relaxed text-slate-600">{text}</p>
                <p class="mt-2 text-sm font-semibold text-brand-navy">{example}</p>
                {index === 1 && <div class="mt-4 lg:hidden"><TariffExample /></div>}
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-8"><a href="/cara-kerja/" class="font-semibold text-brand-blue underline-offset-4 hover:underline">Lihat alur kasir selengkapnya</a></p>
      </div>

      <div class="hidden lg:sticky lg:top-24 lg:block">
        <TariffExample />
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20" aria-labelledby="judul-bukti">
    <div class="mx-auto grid max-w-6xl items-start gap-x-12 gap-y-10 px-4 sm:px-6 lg:grid-cols-[1fr_22rem]">
      <div class="lg:col-start-1 lg:row-start-1">
        <h2 id="judul-bukti" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Resi thermal yang jelas, nilai COD yang presisi</h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600">
          Mengantar memotong fee COD 3% ditambah PPN (3,33%) dari nilai yang ditagih ke penerima. GeraiCuan menghitung nilai COD terkecil,
          dibulatkan ke rupiah penuh, yang setelah dipotong biaya itu tetap menutup harga barang dan ongkir. Kasir tidak perlu menghitung manual.
        </p>
        <table class="mt-8 w-full max-w-xl border-collapse text-base tabular-nums">
          <caption class="pb-3 text-left text-sm text-slate-500">Contoh satu kiriman COD (data rekaan)</caption>
          <tbody class="divide-y divide-slate-200 border-y border-slate-200">
            <tr><th scope="row" class="py-3 text-left font-medium">Harga barang</th><td class="py-3 text-right font-semibold" data-cod="goods">{formatIdr(cod.goodsIdr)}</td></tr>
            <tr><th scope="row" class="py-3 text-left font-medium">Ongkir Mengantar</th><td class="py-3 text-right font-semibold" data-cod="shipping">{formatIdr(cod.shippingIdr)}</td></tr>
            <tr class="outline outline-2 -outline-offset-2 outline-slate-900"><th scope="row" class="px-2 py-3 text-left font-bold">Nilai COD ditagih ke penerima<span class="block text-sm font-normal text-slate-500">angka yang sama tercetak di label</span></th><td class="px-2 py-3 text-right font-bold" data-cod="cod">{formatIdr(cod.codIdr)}</td></tr>
            <tr><th scope="row" class="py-3 text-left font-medium">Biaya COD Mengantar (3,33%)</th><td class="py-3 text-right font-semibold" data-cod="fee">− {formatIdr(cod.mengantarFeeIdr)}</td></tr>
            <tr><th scope="row" class="py-3 text-left font-medium">Ongkir dibayar dari dana COD</th><td class="py-3 text-right font-semibold">− {formatIdr(cod.shippingIdr)}</td></tr>
            <tr class="bg-emerald-50 text-emerald-800"><th scope="row" class="px-2 py-3 text-left font-bold">Estimasi dana dicairkan Mengantar</th><td class="px-2 py-3 text-right font-bold" data-cod="disbursement">{formatIdr(cod.disbursementIdr)}</td></tr>
          </tbody>
        </table>
      </div>
      <ul class="grid max-w-2xl gap-2 text-base text-slate-700 lg:col-start-1 lg:row-start-2">
          <li><strong>10 × 15 cm bawaan:</strong> label paket ditambah bukti serah terima untuk pengirim, atau 10 × 10 cm saja.</li>
          <li><strong>Barcode Code 128</strong> diukur untuk printer thermal 203 dpi.</li>
          <li><strong>Jelas apa yang ditagih:</strong> COD, COD Ongkir ("tagih ongkir saja"), atau Non-COD ("jangan tagih penerima").</li>
        <li><strong>Bukti pengirim</strong> tidak memuat nama, alamat, atau nomor telepon penerima.</li>
      </ul>

      <figure class="row-start-2 grid justify-items-center gap-3 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <div class="thermal" aria-hidden="true">
          <div class="thermal-row thermal-head">
            <span class="thermal-courier">{label.courier}</span>
            <span class="thermal-tag">{label.senderName}</span>
          </div>
          <div class="thermal-row">
            <svg class="thermal-barcode" viewBox={`0 0 ${bars.modules} 1`} preserveAspectRatio="none" shape-rendering="crispEdges">
              {bars.bars.map(([x, width]) => <rect x={x} y="0" width={width} height="1" fill="#000" />)}
            </svg>
            <p class="thermal-awb">{label.awb}</p>
          </div>
          <div class="thermal-row">
            <p><span class="thermal-tag">Penerima</span> <span class="thermal-name">{label.recipientName}</span> {label.recipientPhone}</p>
            <p>{label.recipientArea}</p>
            <p>{label.recipientAddress}</p>
          </div>
          <div class="thermal-row">
            <p class="thermal-cod"><span>COD — tagih ke penerima</span> <b>{formatIdr(cod.codIdr)}</b></p>
            <div class="thermal-money">
              <div><span>Nilai barang</span><span>{formatIdr(cod.goodsIdr)}</span></div>
              <div><span>Ongkir</span><span>{formatIdr(cod.labelOngkirIdr)}</span></div>
            </div>
          </div>
          <div class="thermal-row"><p><b>Isi</b> {label.content} · {label.weight} · 1 koli</p></div>
          <p class="thermal-cut">✂ potong di sini</p>
          <div class="thermal-stub">
            <p class="thermal-stub-title">Bukti serah terima · untuk pengirim</p>
            <div class="thermal-head">
              <span class="thermal-courier">{label.courier}</span>
              <span>COD <b>{formatIdr(cod.codIdr)}</b></span>
            </div>
            <svg class="thermal-barcode" viewBox={`0 0 ${bars.modules} 1`} preserveAspectRatio="none" shape-rendering="crispEdges">
              {bars.bars.map(([x, width]) => <rect x={x} y="0" width={width} height="1" fill="#000" />)}
            </svg>
            <p class="thermal-awb">{label.awb}</p>
          </div>
        </div>
        <figcaption class="max-w-[22rem] text-center text-sm text-slate-500">Contoh label 10 × 15 cm dengan data rekaan. Nama pengirim di label memakai nama gerai Anda.</figcaption>
      </figure>
    </div>
  </section>


  <ClosingCta heading="Buka loket ekspedisi di toko Anda sekarang" />
